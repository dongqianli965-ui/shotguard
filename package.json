    "runway"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "peerDependencies": {
    "ffmpeg": ">=4.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lidongqian/shotguard.git"
  },
