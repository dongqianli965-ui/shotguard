# SHOTGUARD 环境变量配置
#
# 复制本文件为 .env，填入你自己的值。
# 注意：.env 已在 .gitignore 中，不会被提交。

# 视觉模型 API 地址（OpenAI 兼容）
# 示例：
#   OpenAI    https://api.openai.com/v1
#   Claude    https://api.anthropic.com/v1
#   Qwen-VL   https://dashscope.aliyuncs.com/v1
#   本地部署    http://127.0.0.1:8787/v1
VISION_API_BASE_URL=https://api.openai.com/v1

# API 密钥
VISION_API_KEY=sk-your-key-here

# 模型名（必须是支持读图的视觉模型）
# 示例：gpt-4o / claude-3-5-sonnet / qwen-vl-max / gemini-pro-vision
VISION_MODEL=gpt-4o
